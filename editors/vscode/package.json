{
  "name": "potuzhno-syntax",
  "displayName": "ПотужнийСкрипт",
  "description": "Підсвітка синтаксису ПотужнийСкрипт (*.potuzhno): JavaScript з мемними словами",
  "version": "0.1.0",
  "publisher": "maximwas",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.144.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "icon": "icons/potuzhno.png",
  "main": "./extension.cjs",
  "contributes": {
    "languages": [
      {
        "id": "potuzhno",
        "aliases": [
          "ПотужнийСкрипт",
          "potuzhno"
        ],
        "extensions": [
          ".potuzhno"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/potuzhno.svg",
          "dark": "./icons/potuzhno.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "potuzhno",
        "scopeName": "source.potuzhno",
        "path": "./syntaxes/potuzhno.tmLanguage.json"
      },
      {
        "scopeName": "potuzhno.keywords.injection",
        "path": "./syntaxes/potuzhno-keywords.injection.json",
        "injectTo": [
          "source.potuzhno"
        ]
      }
    ],
    "configurationDefaults": {
      "[potuzhno]": {
        "editor.unicodeHighlight.ambiguousCharacters": false
      },
      "cSpell.enabledFileTypes": {
        "potuzhno": false
      }
    }
  },
  "scripts": {
    "generate": "node scripts/generate.ts",
    "build": "esbuild src/create-hover-info-service.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/hover-info-service.cjs",
    "test": "node --test \"test/**/*.test.ts\"",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "tm-grammars": "1.32.22",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  }
}
