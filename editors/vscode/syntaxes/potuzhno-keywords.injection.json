{
  "$comment": "Згенеровано командою npm run generate. Не редагувати вручну.",
  "scopeName": "potuzhno.keywords.injection",
  "injectTo": [
    "source.potuzhno"
  ],
  "injectionSelector": "L:source.potuzhno - (string | comment), L:source.potuzhno meta.template.expression - (string.quoted | string.regexp | comment)",
  "patterns": [
    {
      "match": "(?<![\\p{L}\\p{N}_$])(?:проффесор|перемога|ростов|страус|тарифи|зрада)(?![\\p{L}\\p{N}_$])",
      "name": "constant.language.potuzhno"
    },
    {
      "match": "(?<![\\p{L}\\p{N}_$])(?:два_три_тижні|астанавітесь|не_відступай|хто_не_чув|каденція|кандидат|вивезти|виплата|завезти|застава|пронесе|вибори|відкат|обіцяю|вирок|набу|ато|тво|щоб|як|з)(?![\\p{L}\\p{N}_$])",
      "name": "keyword.control.potuzhno"
    },
    {
      "match": "(?<![\\p{L}\\p{N}_$])(?:великий_український|люстрація|по_новому|порожнеча|анкета|серед|в)(?![\\p{L}\\p{N}_$])",
      "name": "keyword.operator.potuzhno"
    },
    {
      "match": "(?<![\\p{L}\\p{N}_$])(?:плівки)(?![\\p{L}\\p{N}_$])",
      "name": "keyword.other.debugger.potuzhno"
    },
    {
      "match": "(?<![\\p{L}\\p{N}_$])(?:будівництво|завтрашній|довічно|занести|взяти|кум)(?![\\p{L}\\p{N}_$])",
      "name": "storage.modifier.potuzhno"
    },
    {
      "match": "(?<![\\p{L}\\p{N}_$])(?:потужно|партія|батон|совок|схема)(?![\\p{L}\\p{N}_$])",
      "name": "storage.type.potuzhno"
    },
    {
      "match": "(?<![\\p{L}\\p{N}_$])(?:Перевищення|Декларація|МертваДуша|Азірівка|Ахмєтова|Календар|Обіцянка|Фракція|Бюджет|Ганьба|Гривня|Майно|Сімʼя|Віра|Мова|Рада|ОП)(?![\\p{L}\\p{N}_$])",
      "name": "support.class.potuzhno"
    },
    {
      "match": "(?<![\\p{L}\\p{N}_$])(?:папєрєднікі|держава|я_тут)(?![\\p{L}\\p{N}_$])",
      "name": "variable.language.potuzhno"
    },
    {
      "match": "(?<![\\p{L}\\p{N}_$])(?:порахувати_з_копійками|не_тільки_лише_всі|переписати_на_тещу|кожному_по_тисячі|накрутити_в_кінці|оформлено_на_себе|вимкнути_марафон|матеріали_справи|перезавантаження|перенести_весну|місце_у_списку|другий_термін|знайти_винних|номер_винного|після_виборів|весна_прийде|вже_сьогодні|легалізувати|плоска_шкала|формулювання|чи_проффесор|відмити_все|зафіксувати|оприлюднити|телемарафон|договорняк|експертиза|порахувати|призначити|яйця_по_17|в_команду|відставка|звернення|кровосісі|легітимна|накрутити|наповнити|округлити|причетний|провалено|прокладка|розібрати|виконано|картонка|коаліція|кошторис|мало_хто|озвучити|очистити|перегони|порішали|хоч_одна|брифінг|відмити|двійник|конкурс|кулуари|на_вила|прогноз|рейтинг|скільки|степінь|урізати|шашлики|активи|в_темі|ганьба|корінь|майдан|модуль|пенсія|розкол|розпил|садити|статки|шматок|арешт|втеча|єдині|ключі|склад|стеля|транш|коса|дно|ПІ)(?![\\p{L}\\p{N}_$])",
      "name": "support.function.potuzhno"
    }
  ]
}
