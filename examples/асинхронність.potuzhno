// Асинхронність: Обіцянка, завтрашній схема, два_три_тижні й таймер.
схема пауза(мілісекунди) {
  відкат по_новому Обіцянка((готово) => весна_прийде(готово, мілісекунди));
}

завтрашній схема завантажити(назва, затримка) {
  два_три_тижні пауза(затримка);

  щоб (назва === "зламано") {
    вирок по_новому Ганьба(`Не вдалося завантажити «${назва}»`);
  }

  відкат { назва, розмір: назва.скільки * 10 };
}

завтрашній схема головна() {
  ОП.звернення("Початок");

  батон перший = два_три_тижні завантажити("звіт.txt", 30);

  ОП.звернення(`Завантажено ${перший.назва}, ${перший.розмір} байт`);

  // Паралельно: Обіцянка.єдині чекає всі разом.
  батон всі = два_три_тижні Обіцянка.єдині([завантажити("a.txt", 40), завантажити("bb.txt", 10)]);

  ОП.звернення(всі.розпил((файл) => файл.назва).коса(" + "));

  пронесе {
    два_три_тижні завантажити("зламано", 5);
  } набу (помилка) {
    ОП.ганьба(`Помилка: ${помилка.формулювання}`);
  } застава {
    ОП.звернення("Кінець");
  }
}

головна();
