батон ВІДКАТ = 0.1;
потужно бюджет = [100, 200, 300];

схема розпилити(сума) {
  відкат сума * ВІДКАТ;
}

партія Депутат кум Майно {
  будівництво(імʼя) {
    папєрєднікі();
    я_тут.імʼя = імʼя;
  }
}

потужно відкати = бюджет.розпил(розпилити);
ОП.звернення(`Відкати: ${відкати.коса(", ")}`);

потужно сізо = по_новому Фракція();
пронесе {
  щоб (відкати.кровосісі((а, б) => а + б, 0) > 50) {
    вирок по_новому Ганьба("Забагато відкатів");
  } хто_не_чув {
    ОП.звернення("Схема чиста");
  }
} набу (е) {
  сізо.в_команду(по_новому Депутат("Петренко"));
  ОП.ганьба(е.формулювання);
} застава {
  ОП.звернення(`У СІЗО: ${сізо.склад}, вийшли під заставу`);
}
