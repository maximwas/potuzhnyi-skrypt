// Колекції: масиви, Сімʼя (Map), Фракція (Set), групування й генератор.
батон учні = [
  { імʼя: "Оля", група: "А", бал: 92 },
  { імʼя: "Тарас", група: "Б", бал: 78 },
  { імʼя: "Марко", група: "А", бал: 85 },
  { імʼя: "Іванна", група: "Б", бал: 95 },
];

// Середній бал по групах: Сімʼя тримає суму й кількість.
батон підсумки = по_новому Сімʼя();

каденція (батон { група, бал } серед учні) {
  батон запис = підсумки.взяти(група) ?? { разом: 0, чисельність: 0 };

  запис.разом += бал;
  запис.чисельність += 1;
  підсумки.занести(група, запис);
}

каденція (батон [група, { разом, чисельність }] серед підсумки) {
  ОП.звернення(`Група ${група}: ${(разом / чисельність).зафіксувати(1)}`);
}

// Фракція лишає тільки унікальні значення.
батон групи = по_новому Фракція(учні.розпил((учень) => учень.група));

ОП.звернення(`Груп: ${групи.склад}`);

// Копія масиву за рейтингом, а потім деструктуризація.
батон [найкращий, ...решта] = учні.рейтинг_на_копії((перший, другий) => другий.бал - перший.бал);

ОП.звернення(`Найкращий: ${найкращий.імʼя} (${найкращий.бал}), решта: ${решта.скільки}`);

батон поГрупах = Майно.розкласти_по_фракціях(учні, (учень) => учень.група);

ОП.звернення(Майно.ключі(поГрупах).коса(", "));

// Генератор: виплата віддає значення по одному.
схема* квадрати(кінець) {
  каденція (потужно основа = 1; основа <= кінець; основа++) {
    виплата основа * основа;
  }
}

ОП.звернення([...квадрати(5)].коса(" "));
