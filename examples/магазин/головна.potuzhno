// Точка входу. Запуск: node bin/potuzhno.ts examples/магазин/головна.potuzhno
завезти Кошик з "./кошик.potuzhno"; // за замовчуванням
завезти { ПДВ, гривні як формат } з "./гроші.potuzhno"; // іменовані, з псевдонімом
завезти * як вітрина з "./індекс.potuzhno"; // увесь модуль одним обʼєктом

батон кошик = по_новому Кошик();

кошик.додати("Хліб", 2).додати("Сир");

ОП.звернення(`Без ПДВ: ${формат(кошик.сума)}`);
ОП.звернення(`З ПДВ ${ПДВ * 100}%: ${формат(вітрина.зПДВ(кошик.сума))}`);
ОП.звернення(`У каталозі товарів: ${вітрина.КАТАЛОГ.скільки}`);

пронесе {
  кошик.додати("Лимон");
} набу (помилка) {
  ОП.ганьба(`Помилка: ${помилка.формулювання}`);
}

// Динамічний імпорт: завезти як функція повертає Обіцянку.
батон гроші = два_три_тижні завезти("./гроші.potuzhno");

ОП.звернення(`Динамічно: ${гроші.гривні(гроші.зПДВ(100))}`);
