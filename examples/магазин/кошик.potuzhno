// Експорт за замовчуванням: вивезти тво. Сам модуль теж імпортує сусідів.
завезти { знайтиТовар } з "./товари.potuzhno";

вивезти тво партія Кошик {
  будівництво() {
    я_тут.позиції = [];
  }

  додати(назва, кількість = 1) {
    батон товар = знайтиТовар(назва);

    щоб (!товар) {
      вирок по_новому Ганьба(`Немає товару «${назва}»`);
    }

    я_тут.позиції.садити({ товар, кількість });

    відкат я_тут;
  }

  взяти сума() {
    відкат я_тут.позиції.кровосісі((разом, { товар, кількість }) => разом + товар.ціна * кількість, 0);
  }
}
