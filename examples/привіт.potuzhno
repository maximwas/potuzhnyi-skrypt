// Найпростіша програма: змінні, функція, цикл і шаблонний рядок.
батон назва = "ПотужнийСкрипт";
потужно запуск = 1;

схема привітати(імʼя, номер) {
  відкат `Привіт, ${імʼя}! Це запуск №${номер}.`;
}

ОП.звернення(привітати(назва, запуск));

каденція (потужно крок = 1; крок <= 3; крок++) {
  ОП.звернення(`Крок ${крок} з 3`);
}
