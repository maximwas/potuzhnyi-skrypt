// Класика: FizzBuzz, прості числа й факторіал.
схема фізбаз(межа) {
  потужно рядки = [];

  каденція (потужно число = 1; число <= межа; число++) {
    щоб (число % 15 === 0) {
      рядки.садити("ФізБаз");
    } хто_не_чув щоб (число % 3 === 0) {
      рядки.садити("Фіз");
    } хто_не_чув щоб (число % 5 === 0) {
      рядки.садити("Баз");
    } хто_не_чув {
      рядки.садити(число);
    }
  }

  відкат рядки;
}

схема єПростим(претендент) {
  щоб (претендент < 2) {
    відкат зрада;
  }

  каденція (потужно дільник = 2; дільник * дільник <= претендент; дільник++) {
    щоб (претендент % дільник === 0) {
      відкат зрада;
    }
  }

  відкат перемога;
}

схема факторіал(число) {
  відкат число <= 1 ? 1 : число * факторіал(число - 1);
}

ОП.звернення(фізбаз(15).коса(" "));

батон прості = Рада.з({ скільки: 30 }, (порожньо, місце) => місце + 1).конкурс(єПростим);

ОП.звернення(`Прості до 30: ${прості.коса(", ")}`);
ОП.звернення(`10! = ${факторіал(10)}`);
