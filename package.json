{
  "name": "potuzhnyi-script",
  "version": "0.1.1",
  "description": "ПотужнийСкрипт — мемна мова програмування поверх JavaScript",
  "license": "MIT",
  "author": "maximwas",
  "type": "module",
  "bin": {
    "potuzhno": "./dist/bin/potuzhno.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/container.d.ts",
      "default": "./dist/src/container.js"
    },
    "./register": {
      "types": "./dist/src/register.d.ts",
      "default": "./dist/src/register.js"
    }
  },
  "engines": {
    "node": ">=26.2"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write \"{src,bin,test}/**/*.ts\" \"*.js\"",
    "format:check": "prettier --check \"{src,bin,test}/**/*.ts\" \"*.js\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run check && npm run build && npm run build:extension",
    "build:extension": "mkdir -p extension && npm run package --prefix editors/vscode -- --out ../../extension/potuzhno-syntax.vsix"
  },
  "dependencies": {
    "awilix": "13.0.5",
    "chokidar": "6.0.0",
    "esbuild": "0.28.2",
    "js-tokens": "10.0.0",
    "kmu-translit": "1.0.0",
    "magic-string": "1.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "files": [
    "dist/bin",
    "dist/src",
    "extension/potuzhno-syntax.vsix",
    "README.md"
  ],
  "keywords": [
    "potuzhno",
    "javascript",
    "esoteric",
    "meme",
    "ukrainian",
    "language",
    "transpiler"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maximwas/potuzhnyi-skrypt.git"
  },
  "bugs": {
    "url": "https://github.com/maximwas/potuzhnyi-skrypt/issues"
  }
}
