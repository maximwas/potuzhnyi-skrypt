  "name": "examples/бюджет.potuzhno",
  "source": "батон ВІДКАТ = 0.1;\nпотужно бюджет = [100, 200, 300];\n\nсхема розпилити(сума) {\n  відкат сума * ВІДКАТ;\n}\n\nпартія Депутат кум Майно {\n  будівництво(імʼя) {\n    папєрєднікі();\n    я_тут.імʼя = імʼя;\n  }\n}\n\nпотужно відкати = бюджет.розпил(розпилити);\nОП.звернення(`Відкати: ${відкати.коса(\", \")}`);\n\nпотужно сізо = по_новому Фракція();\nпронесе {\n  щоб (відкати.кровосісі((а, б) => а + б, 0) > 50) {\n    вирок по_новому Ганьба(\"Забагато відкатів\");\n  } хто_не_чув {\n    ОП.звернення(\"Схема чиста\");\n  }\n} набу (е) {\n  сізо.в_команду(по_новому Депутат(\"Петренко\"));\n  ОП.ганьба(е.формулювання);\n} застава {\n  ОП.звернення(`У СІЗО: ${сізо.склад}, вийшли під заставу`);\n}\n"
 },
