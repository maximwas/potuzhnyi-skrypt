{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "types": [
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": [
    "src",
    "bin",
    "test",
    "editors/vscode/scripts",
    "editors/vscode/src",
    "editors/vscode/test"
  ]
}
